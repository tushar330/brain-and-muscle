# =========================================================================
# BRAIN & MUSCLE - BACKEND ENVIRONMENT TEMPLATE
# =========================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file to version control.

# -------------------------------------------------------------------------
# 1. NODE IDENTITY
# -------------------------------------------------------------------------
# Unique identifier for this node (e.g., brain-1, muscle-1)
NODE_ID=brain-1

# -------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (BRAIN ONLY)
# -------------------------------------------------------------------------
# PostgreSQL connection string (Supabase)
DATABASE_URL=postgres://user:pass@host:port/dbname

# -------------------------------------------------------------------------
# 3. AZURE BLOB STORAGE CONFIGURATION (BRAIN ONLY)
# -------------------------------------------------------------------------
# Connection string for Azure Storage Account
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# Target container for task outputs (logs/results)
AZURE_CONTAINER_NAME=task-outputs

# -------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# -------------------------------------------------------------------------
# Secret key used to validate X-API-Key headers from the Frontend/Muscle
# This MUST match the key in your Frontend .env.local
BRAIN_API_KEY=your_brain_secret_key_here

# Supabase JWT Secret for user authentication
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# -------------------------------------------------------------------------
# 5. NETWORKING
# -------------------------------------------------------------------------
# The host/IP where this node will listen (Dev: 0.0.0.0)
BRAIN_HOST=0.0.0.0

# HTTP Control Plane Port (Default: 8888)
HTTP_PORT=8888

# TCP Data Plane Port (Default: 9000)
PORT=9000

# Comma-separated list of other Brain nodes (for Raft consensus)
# PEERS=localhost:9001,localhost:9002
